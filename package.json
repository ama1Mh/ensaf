{
  "name": "ensaf",
  "version": "3.0.0",
  "description": "Accessible e-learning platform with head tracking for motor-impaired students",
  "main": "index.html",
  "scripts": {
    "start": "http-server -p 8000 -c-1 .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "bench": "node tests/bench/accuracy-sim.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ama1Mh/ensaf.git"
  },
  "keywords": [
    "accessibility",
    "head-tracking",
    "e-learning",
    "assistive-technology",
    "mediapipe",
    "arabic",
    "motor-disabilities"
  ],
  "author": "ENSAF Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ama1Mh/ensaf/issues"
  },
  "homepage": "https://ama1mh.github.io/ensaf/",
  "dependencies": {
    "firebase": "^12.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "http-server": "^14.1.1"
  }
}
